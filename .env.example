# Tier 3 (LLM adjudicator) uses the Anthropic API.
# Leave unset to run Khata fully offline — Tier 3 degrades to the
# deterministic narration parser and every skipped credit is logged
# with reason code NEEDS_LLM_REVIEW.
ANTHROPIC_API_KEY=sk-ant-...
KHATA_MODEL=claude-opus-5

# Optional: the real Razorpay settlement endpoints, in place of the simulator.
# Test-mode keys from the dashboard: Settings -> API Keys -> Test Mode.
# Without these, `--live-gateway` refuses to start and everything else is
# unaffected -- the simulated gateway is the default.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
